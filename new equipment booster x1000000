class ForgingMiningEngine:
    """Simulates resource mining and token forging protocols via consensus simulation."""
    def compute_proof_of_equipment(self, last_proof: int) -> int:
        logger.info("Initiating structural equipment mining cycles...")
        proof = 0
        while not self.is_valid_proof(last_proof, proof):
            proof += 1
        logger.info(f"New block forged successfully. Proof: {proof}")
        return proof

    @staticmethod
    def is_valid_proof(last_proof: int, proof: int) -> bool:
        guess = f'{last_proof}{proof}'.encode()
        guess_hash = hashlib.sha256(guess).hexdigest()
        return guess_hash[:4] == "0000"

