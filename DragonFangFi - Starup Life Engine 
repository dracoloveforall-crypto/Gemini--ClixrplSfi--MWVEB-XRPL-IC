        for route, latencies in connection_telemetry.items():
            avg_lag = sum(latencies) / len(latencies) if latencies else 0
            jitter = max(latencies) - min(latencies) if latencies else 0
            
            # Identify micro-bugs via anomaly detection (sudden latency spikes)
            has_bug = any(latency > (avg_lag * 3) for latency in latencies)
            
